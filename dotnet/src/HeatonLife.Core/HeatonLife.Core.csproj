<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>HeatonLife</RootNamespace>
    <!-- Source of truth for the Build Library (.NET) workflow's version stamping
         (mirrors python/pyproject.toml). Bump this for releases. -->
    <Version>1.0.0</Version>
    <Description>Explore emergence in .NET: cellular automata (MergeLife, Life-like, Elementary, Cyclic, Wireworld), three flavors of Lenia, escape-time fractals with deep zoom (Mandelbrot, Julia, Burning Ship, Newton), Reynolds boids, and Gray-Scott reaction-diffusion under one consistent API, plus a genetic evolver that searches for new MergeLife rules. Pure C#, netstandard2.1, zero dependencies: it runs anywhere .NET does, including Unity and IL2CPP, and its step and frame APIs allocate nothing. Every system follows a written specification and conformance vectors shared with the Python package, so the same parameters and seed give the same run in either language.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!-- Ship IntelliSense docs alongside the DLL (Unity reads the .xml next to it).
         CS1591 stays off: undocumented public members are fine; spec-relevant docs exist. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- NuGet package metadata (package id "HeatonLife.Core" — the assembly name matches) -->
  <PropertyGroup>
    <PackageId>HeatonLife.Core</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>heaton_life_icon.png</PackageIcon>
    <Authors>Jeff Heaton</Authors>
    <PackageTags>cellular-automata;lenia;fractals;boids;reaction-diffusion;mergelife;emergence;artificial-life</PackageTags>
    <PackageProjectUrl>https://github.com/jeffheaton/heaton-life</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jeffheaton/heaton-life</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../../docs/heaton_life_icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HeatonLife.Core.Tests" />
    <!-- Downstream hosts consume this assembly as a DLL; their conformance and
         self-check assemblies replay the vectors against internals (e.g.
         FractalEngine.Fma), so the grants are compiled in here. -->
    <InternalsVisibleTo Include="HeatonLife.Core.EditorTests" />
    <InternalsVisibleTo Include="HeatonLife.Unity" />
  </ItemGroup>

</Project>
