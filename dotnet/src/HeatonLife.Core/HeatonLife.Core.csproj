<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>HeatonLife</RootNamespace>
    <!-- Source of truth for the Build Library (.NET) workflow's version stamping
         (mirrors python/pyproject.toml). Bump this for releases. -->
    <Version>1.0.0</Version>
    <Description>Emergence algorithms: cellular automata, Lenia, fractals, boids, reaction-diffusion. Spec-first port of heaton-life; conforms to the shared vectors.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!-- Ship IntelliSense docs alongside the DLL (Unity reads the .xml next to it).
         CS1591 stays off: undocumented public members are fine; spec-relevant docs exist. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- NuGet package metadata (package id "HeatonLife.Core" — the assembly name matches) -->
  <PropertyGroup>
    <PackageId>HeatonLife.Core</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Jeff Heaton</Authors>
    <PackageTags>cellular-automata;lenia;fractals;boids;reaction-diffusion;mergelife;emergence;artificial-life</PackageTags>
    <PackageProjectUrl>https://github.com/jeffheaton/heaton-life</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jeffheaton/heaton-life</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HeatonLife.Core.Tests" />
    <!-- Downstream hosts consume this assembly as a DLL; their conformance and
         self-check assemblies replay the vectors against internals (e.g.
         FractalEngine.Fma), so the grants are compiled in here. -->
    <InternalsVisibleTo Include="HeatonLife.Core.EditorTests" />
    <InternalsVisibleTo Include="HeatonLife.Unity" />
  </ItemGroup>

</Project>
