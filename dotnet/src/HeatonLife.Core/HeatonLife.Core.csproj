<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>HeatonLife</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Emergence algorithms: cellular automata, Lenia, fractals, boids, reaction-diffusion. Spec-first port of heaton-life; conforms to the shared vectors.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!-- Ship IntelliSense docs alongside the DLL (Unity reads the .xml next to it).
         CS1591 stays off: undocumented public members are fine; spec-relevant docs exist. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HeatonLife.Core.Tests" />
    <!-- The Unity app (heaton-life-unity, its own repo) consumes this assembly as a DLL.
         Its EditMode conformance suite replays the vectors against internals (e.g.
         FractalEngine.Fma) and its on-device self-check uses the same, so the grants
         must be compiled in here. -->
    <InternalsVisibleTo Include="HeatonLife.Core.EditorTests" />
    <InternalsVisibleTo Include="HeatonLife.Unity" />
  </ItemGroup>

</Project>
