<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>HeatonLife</RootNamespace>
    <!-- Source of truth for the Build Library (.NET) workflow's version stamping
         (mirrors python/pyproject.toml). Bump this for releases. -->
    <Version>1.1.0</Version>
    <Description>Explore emergence in .NET: cellular automata (MergeLife, Life-like, Elementary, Cyclic, Wireworld), three flavors of Lenia, fractals (Newton's basins, and Mandelbrot, Julia, and Burning Ship with deep zoom, to 1e9000 for Mandelbrot and Julia), Reynolds boids, and Gray-Scott reaction-diffusion under one consistent API, plus a genetic evolver that searches for new MergeLife rules. Pure C#, netstandard2.1, zero dependencies: it runs anywhere .NET does, including Unity and IL2CPP, and its step and frame APIs allocate nothing. Every system follows a written specification and conformance vectors shared with the Python package, so the same parameters and seed give the same run in either language.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!-- Ship IntelliSense docs alongside the DLL (Unity reads the .xml next to it).
         CS1591 stays off: undocumented public members are fine; spec-relevant docs exist. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Symbols: a .snupkg with the portable PDB is packed beside the .nupkg and pushed
         with it. SourceLink (built into the SDK) maps the PDB back to this repository at
         the packed commit (every file but the CI-regenerated Version.cs), and the
         workflow builds with ContinuousIntegrationBuild so the paths are deterministic. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- NuGet package metadata (package id "HeatonLife.Core" — the assembly name matches) -->
  <PropertyGroup>
    <PackageId>HeatonLife.Core</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>heaton_life_icon.png</PackageIcon>
    <Authors>Jeff Heaton</Authors>
    <PackageTags>cellular-automata;lenia;fractals;boids;reaction-diffusion;mergelife;emergence;artificial-life</PackageTags>
    <PackageProjectUrl>https://github.com/jeffheaton/heaton-life</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jeffheaton/heaton-life</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>What changed in each version: https://github.com/jeffheaton/heaton-life/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../../docs/heaton_life_icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The only grant. Downstream hosts (the Unity app's EditMode suite among them)
         build on the public API: the platform self-check (SelfCheck) is public, so no
         host needs internals to prove its runtime. -->
    <InternalsVisibleTo Include="HeatonLife.Core.Tests" />
  </ItemGroup>

</Project>
